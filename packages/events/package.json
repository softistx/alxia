{
	"name": "@alxia/events",
	"version": "0.1.1",
	"description": "An event bus for an application on @nxgt/mongo and @nxgt/redis: events written to a transactional outbox with the domain change, relayed to queues, delivered at least once and applied once through an inbox",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/events"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/modules": "workspace:^",
		"@alxia/tenancy": "workspace:^",
		"@nxgt/mongo": "^0.25.1",
		"@nxgt/redis": "^0.9.2",
		"@types/bun": "^1.4.4",
		"mongodb": "^7.7.0",
		"mongodb-memory-server-core": "^11.3.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@alxia/modules": "workspace:^",
		"@alxia/tenancy": "workspace:^",
		"@nxgt/mongo": "^0.25.1",
		"@nxgt/redis": "^0.9.0",
		"mongodb": "^7.7.0",
		"typescript": "^6.0.3 || ^7.0.0",
		"zod": "^4.6.5"
	}
}
