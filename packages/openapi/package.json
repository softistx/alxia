{
	"name": "@alxia/openapi",
	"version": "0.4.1",
	"description": "OpenAPI spec first for @alxia/core: the routes of an app bound to the operations generated from its document, and checked against them",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/openapi"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/secure-headers": "workspace:^",
		"@types/bun": "^1.4.2",
		"zod": "^4.2.0"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
