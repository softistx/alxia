		"@types/react-dom": "^19.3.0",
		"graphql": "^17.0.2",
		"happy-dom": "^20",
		"intl-messageformat": "^12.1.4",
		"isbot": "^5.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"vite": "^7.0.0",
		"workbox-core": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-navigation-preload": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"zod": "^4.2.0"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"isbot": "^5.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^8.0.0",
		"typescript": "^6.0.3 || ^7.0.0",
		"vite": "^7.0.0 || ^8.0.0",
		"workbox-core": "^7.0.0",
		"workbox-expiration": "^7.0.0",
		"workbox-navigation-preload": "^7.0.0",
		"workbox-precaching": "^7.0.0",
		"workbox-routing": "^7.0.0",
		"workbox-strategies": "^7.0.0"
	},
