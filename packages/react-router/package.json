{
	"name": "@alxia/react-router",
	"version": "0.9.0",
	"description": "alxia as the server of a React Router framework app: server rendering behind the app's hooks, loaders reading its typed context, the client's assets served; the code with no UI an installable app shares (`/pwa`), its hooks (`/pwa/react`), `noCache` for the worker's script (`/pwa/server`) and the service worker on Workbox (`/pwa/worker`)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"alxia-react-router": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"import": "./dist/vite/index.js",
			"default": "./dist/vite/index.js"
		},
		"./pwa": {
			"types": "./dist/pwa/index.d.ts",
			"import": "./dist/pwa/index.js",
			"default": "./dist/pwa/index.js"
		},
		"./pwa/react": {
			"types": "./dist/pwa/react/index.d.ts",
			"import": "./dist/pwa/react/index.js",
			"default": "./dist/pwa/react/index.js"
		},
		"./pwa/server": {
			"types": "./dist/pwa/server/index.d.ts",
			"import": "./dist/pwa/server/index.js",
			"default": "./dist/pwa/server/index.js"
		},
		"./pwa/worker": {
			"types": "./dist/pwa/worker/index.d.ts",
			"import": "./dist/pwa/worker/index.js",
			"default": "./dist/pwa/worker/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/react-router"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit && tsc --noEmit -p fixture"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts",
			"src/vite/index.ts",
			"src/pwa/index.ts",
			"src/pwa/react/index.ts",
			"src/pwa/server/index.ts",
			"src/pwa/worker/index.ts",
			"src/cli/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/compress": "workspace:^",
		"@alxia/core": "workspace:^",
		"@alxia/openapi": "workspace:^",
		"@react-router/dev": "^8.5.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"isbot": "^5.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"vite": "^7.0.0",
		"workbox-core": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-navigation-preload": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"react": "^19.0.0",
		"react-router": "^8.0.0",
		"typescript": "^6.0.3 || ^7.0.0",
		"vite": "^7.0.0 || ^8.0.0",
		"workbox-core": "^7.0.0",
		"workbox-expiration": "^7.0.0",
		"workbox-navigation-preload": "^7.0.0",
		"workbox-precaching": "^7.0.0",
		"workbox-routing": "^7.0.0",
		"workbox-strategies": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"workbox-core": {
			"optional": true
		},
		"workbox-expiration": {
			"optional": true
		},
		"workbox-navigation-preload": {
			"optional": true
		},
		"workbox-precaching": {
			"optional": true
		},
		"workbox-routing": {
			"optional": true
		},
		"workbox-strategies": {
			"optional": true
		}
	}
}
