{
	"name": "@alxia/react-router",
	"version": "0.6.2",
	"description": "alxia as the server of a React Router framework app: server rendering behind the app's hooks, loaders reading its typed context, the client's assets served",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"alxia-react-router": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"import": "./dist/vite/index.js",
			"default": "./dist/vite/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/react-router"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit && tsc --noEmit -p fixture"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts",
			"src/vite/index.ts",
			"src/cli/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/compress": "workspace:^",
		"@alxia/core": "workspace:^",
		"@alxia/openapi": "workspace:^",
		"@react-router/dev": "^8.4.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"isbot": "^5.2.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"vite": "^7.0.0"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"react-router": "^8.0.0",
		"typescript": "^6.0.3 || ^7.0.0",
		"vite": "^7.0.0 || ^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
