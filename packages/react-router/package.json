{
	"name": "@alxia/react-router",
	"version": "0.19.0",
	"description": "alxia as the server of a React Router framework app: server rendering behind the app's hooks, loaders reading its typed context, the client's assets served; the code with no UI an installable app shares (`/pwa`), its hooks (`/pwa/react`), `noCache` for the worker's script (`/pwa/server`), the service worker on Workbox (`/pwa/worker`) and its build (`/pwa/build`), an API's refusals worded for the page (`/errors`), the BFF session: cookies, sign-in, step-up and mail links (`/session`), its page hooks (`/session/react`) and what it shares with the page (`/session/model`), a GraphQL subscription relayed to the browser over SSE (`/subscription`), the page's CSP nonce and inline boot scripts (`/document`) and a streaming `entry.server` (`/entry`)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"alxia-react-router": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"import": "./dist/vite/index.js",
			"default": "./dist/vite/index.js"
		},
		"./pwa": {
			"types": "./dist/pwa/index.d.ts",
			"import": "./dist/pwa/index.js",
			"default": "./dist/pwa/index.js"
		},
		"./pwa/react": {
			"types": "./dist/pwa/react/index.d.ts",
			"import": "./dist/pwa/react/index.js",
			"default": "./dist/pwa/react/index.js"
		},
		"./document": {
			"types": "./dist/document/index.d.ts",
			"import": "./dist/document/index.js",
			"default": "./dist/document/index.js"
		},
		"./entry": {
			"types": "./dist/entry/index.d.ts",
			"import": "./dist/entry/index.js",
			"default": "./dist/entry/index.js"
		},
		"./pwa/server": {
			"types": "./dist/pwa/server/index.d.ts",
			"import": "./dist/pwa/server/index.js",
			"default": "./dist/pwa/server/index.js"
		},
		"./errors": {
			"types": "./dist/errors/index.d.ts",
			"import": "./dist/errors/index.js",
			"default": "./dist/errors/index.js"
		},
		"./session": {
			"types": "./dist/session/index.d.ts",
			"import": "./dist/session/index.js",
			"default": "./dist/session/index.js"
		},
		"./pwa/build": {
			"types": "./dist/pwa/build/index.d.ts",
			"import": "./dist/pwa/build/index.js",
			"default": "./dist/pwa/build/index.js"
		},
		"./pwa/worker": {
			"types": "./dist/pwa/worker/index.d.ts",
			"import": "./dist/pwa/worker/index.js",
			"default": "./dist/pwa/worker/index.js"
		},
		"./session/react": {
			"types": "./dist/session/react/index.d.ts",
			"import": "./dist/session/react/index.js",
			"default": "./dist/session/react/index.js"
		},
		"./session/model": {
			"types": "./dist/session/model/index.d.ts",
			"import": "./dist/session/model/index.js",
			"default": "./dist/session/model/index.js"
		},
		"./subscription": {
			"types": "./dist/subscription/index.d.ts",
			"import": "./dist/subscription/index.js",
			"default": "./dist/subscription/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/react-router"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit && tsc --noEmit -p fixture"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts",
			"src/vite/index.ts",
			"src/pwa/index.ts",
			"src/pwa/react/index.ts",
			"src/pwa/server/index.ts",
			"src/errors/index.ts",
			"src/session/model/index.ts",
			"src/session/index.ts",
			"src/session/react/index.ts",
			"src/subscription/index.ts",
			"src/document/index.ts",
			"src/entry/index.ts",
			"src/pwa/worker/index.ts",
			"src/pwa/build/index.ts",
			"src/cli/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/compress": "workspace:^",
		"@alxia/core": "workspace:^",
		"@alxia/openapi": "workspace:^",
		"@nxgt/graphql-client": "^0.4.0",
		"@nxgt/janus": "^0.29.0",
		"@react-router/dev": "^8.5.0",
		"@types/bun": "^1.4.4",
