{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_ENV=development react-router dev",
    "start": "NODE_ENV=production bun build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "verify": "bun run check:ci && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@alxia/core": "workspace:^",
    "@alxia/react-router": "workspace:^",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "isbot": "^5.1.36",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
