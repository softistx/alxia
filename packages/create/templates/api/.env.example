# Copy to .env, which Bun loads on every command: bun dev, bun test, bun start.
# string, required; default dev-key in development and test alone, secret
# Left out: a .env holding it would give `bun start` the development key too.
# An empty value is refused, even under bun dev: give it one, or leave it out.
# API_KEY=change-me

# boolean, optional, default true in development, false elsewhere: the API reference at /docs
# API_DOCS=true

# number, optional, default 3000
PORT=3000
