{
	"name": "@alxia/create",
	"version": "0.1.7",
	"description": "Start an alxia app: `bun create @alxia` writes an API with Zod, or React Router's official template served by alxia",
	"license": "MIT",
	"type": "module",
	"bin": {
		"create-alxia": "./dist/index.js"
	},
	"files": [
		"dist",
		"docs",
		"templates/api",
		"templates/react-router",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/create"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test ./src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/openapi": "workspace:^",
		"@alxia/react-router": "workspace:^",
		"@nxgt/openapi-codegen": "0.7.0",
		"@types/bun": "^1.4.2",
		"zod": "^4.6.5"
	}
}
