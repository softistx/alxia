{
	"name": "@alxia/access",
	"version": "0.1.0",
	"description": "Permissions, roles and guards for an application: a role catalogue built from the modules' permissions and default grants, boot errors for an unknown or duplicate permission, request guards over a tenant scope and a hook mapping refusals to the host's error codes",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/access"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/modules": "workspace:^",
		"@types/bun": "^1.4.4"
	},
	"peerDependencies": {
		"@alxia/modules": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
