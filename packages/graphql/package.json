{
	"name": "@alxia/graphql",
	"version": "0.6.3",
	"description": "GraphQL for alxia with GraphQL Yoga: its plugins, subscriptions over SSE or WebSocket (graphql-ws) and GraphiQL, behind the app's hooks, its resolvers reading the app's typed context",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/graphql"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/logger": "workspace:^",
		"@alxia/telemetry": "workspace:^",
		"@envelop/depth-limit": "^7.2.1",
		"@graphql-yoga/plugin-csrf-prevention": "^3.24.2",
		"@graphql-yoga/plugin-persisted-operations": "^3.24.2",
		"@nxgt/telemetry": "^0.2.1",
		"@types/bun": "^1.4.2",
		"dataloader": "^2.2.3",
		"graphql": "^16.11.0",
		"graphql-ws": "^6.3.0",
		"graphql-yoga": "^5.16.0"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"graphql": "^16.11.0 || ^17.0.0",
		"graphql-ws": "^6.1.0",
		"graphql-yoga": "^5.16.0",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"graphql-ws": {
			"optional": true
		}
	}
}
